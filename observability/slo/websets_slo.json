{
  "service": "webset-miner",
  "tier": "1",
  "slis": [
    {
      "name": "availability",
      "target": 99.9,
      "measurement": "(1 - rate(websets_http_requests_total{status_code!~'2..'}[5m]) / rate(websets_http_requests_total[5m])) * 100"
    },
    {
      "name": "latency",
      "target": 99,
      "measurement": "histogram_quantile(0.95, sum(rate(websets_http_request_duration_seconds_bucket[5m])) by (le)) < 0.5"
    },
    {
      "name": "error_rate",
      "target": 99.9,
      "measurement": "(1 - rate(websets_http_requests_total{status_code!~'2..'}[5m]) / rate(websets_http_requests_total[5m])) * 100"
    },
    {
      "name": "throughput",
      "target": 99,
      "measurement": "rate(websets_http_requests_total[5m]) > 100"
    }
  ],
  "alerting": {
    "burn_rate_threshold": 2,
    "error_budget_window": "30d"
  },
  "dashboard": {
    "grafana_uid": "websets-slo",
    "backstage_link": "https://backstage.example.com/webset-miner"
  }
}
