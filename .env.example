# Example .env for non-secret configuration.
# All sensitive secrets must be stored in Vault using vault_secrets_template.json

# --- Vault Configuration ---
VAULT_ADDR="http://localhost:8200"
# Provide VAULT_TOKEN via Docker secrets or environment variables
VAULT_SECRET_PATH="secret/data/websets"

# Non-secret settings
DATA_DIR=./data
VECTOR_STORE_PATH=./data/vector_store
MAX_CONCURRENT_CRAWLS=5
REQUEST_DELAY_MS=1000
USER_AGENT=WebSetMiner/1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Credentials for local development
# Used by make dev and scripts/run_job.py; override as needed
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=admin
WEBSETS_TEST_USER_PASSWORD=testpassword123

# --- MinIO TLS Configuration ---
MINIO_ENDPOINT=https://minio:9000
MINIO_BUCKET=websets-data
MINIO_CA_CERT=/certs/ca.crt
MINIO_CLIENT_CERT=/certs/app.crt
MINIO_CLIENT_KEY=/certs/app.key
