{
  "title": "Websets Job Health",
  "panels": [
    {
      "type": "stat",
      "title": "Active Jobs",
      "targets": [
        { "expr": "websets_active_jobs" }
      ]
    },
    {
      "type": "graph",
      "title": "Job Failure Rate",
      "targets": [
        { "expr": "rate(websets_jobs_total{status='failed'}[5m])" }
      ]
    },
    {
      "type": "graph",
      "title": "P95 Job Duration",
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(websets_job_duration_seconds_bucket[5m]))" }
      ]
    }
  ]
}
