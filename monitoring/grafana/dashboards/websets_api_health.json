{
  "title": "Websets API Health",
  "panels": [
    {
      "type": "graph",
      "title": "HTTP Requests",
      "targets": [
        { "expr": "rate(websets_http_requests_total[1m])" }
      ]
    },
    {
      "type": "graph",
      "title": "Error Rate",
      "targets": [
        { "expr": "rate(websets_http_requests_total{status_code!~'2..'}[5m]) / rate(websets_http_requests_total[5m])" }
      ]
    },
    {
      "type": "graph",
      "title": "P95 Latency",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(websets_http_request_duration_seconds_bucket[5m])) by (le))" }
      ]
    }
  ]
}
