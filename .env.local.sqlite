# Simplified local development environment (SQLite + Redis)
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite Database Configuration (easier for local dev)
DATABASE_URL=sqlite:///./data/websets_local.db

# Redis Configuration
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Local paths
DATA_DIR=./data
VECTOR_STORE_PATH=./data/vector_store

# API Keys (for development - replace with real keys when needed)
OPENAI_API_KEY=sk-dev-openai-key-for-local-development-only-0123456789

# WorkOS Configuration (test keys)
WORKOS_API_KEY_TEST=sk_test_a2V5XzAxSkU0VEtXSFZNWjVSMVc5WU0wVlkyNk5OLHZvaHZmQ0oxQ3FSamcxS3g4YVIyMHJrblk
WORKOS_CLIENT_ID_TEST=client_01JE4TKWHVMZ5R1W9YM0VY26NN

# Local development settings
