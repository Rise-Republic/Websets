# This is an example .env file for local development without Vault.
# For production or staging, secrets should be managed by Vault.

# --- Vault Configuration ---
# If these are set, the application will attempt to fetch all other secrets from Vault.
VAULT_ADDR="http://localhost:8200"
VAULT_TOKEN="your-vault-token"
VAULT_SECRET_PATH="secret/data/websets"

# --- Local Development Fallback Secrets ---
# These are used only if Vault is NOT configured.

# API Keys
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Database
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/websets"

# Redis/Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Authentication
JWT_SECRET_KEY="a-local-secret-key-for-dev-at-least-32-chars-long"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
DATA_DIR=./data
VECTOR_STORE_PATH=./data/vector_store

# Crawler Settings
MAX_CONCURRENT_CRAWLS=5
REQUEST_DELAY_MS=1000
USER_AGENT=WebSetMiner/1.0

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO