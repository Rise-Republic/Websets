{
  "title": "Websets SLO Dashboard",
  "panels": [
    {
      "type": "gauge",
      "title": "Availability",
      "targets": [
        { "expr": "slo_availability" }
      ]
    },
    {
      "type": "graph",
      "title": "P95 Latency",
      "targets": [
        { "expr": "slo_latency_p95" }
      ]
    },
    {
      "type": "graph",
      "title": "Error Budget Burn",
      "targets": [
        { "expr": "slo_error_budget_burn_rate" }
      ]
    }
  ]
}
